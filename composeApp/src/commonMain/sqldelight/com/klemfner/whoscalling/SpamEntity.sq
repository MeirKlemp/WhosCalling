CREATE TABLE IF NOT EXISTS SpamEntity (
    phoneNumber TEXT NOT NULL PRIMARY KEY,
    detectedAsSpam INTEGER NOT NULL DEFAULT 0,
    reportedAs TEXT,
    detectionTimestamp INTEGER,
    reportingTimestamp INTEGER
);

getAllSpams:
SELECT * FROM SpamEntity;

getSpamByPhoneNumber:
SELECT * FROM SpamEntity WHERE phoneNumber = ?;

insertSpam:
INSERT OR REPLACE INTO SpamEntity (phoneNumber, detectedAsSpam, reportedAs, detectionTimestamp, reportingTimestamp)
VALUES (?, ?, ?, ?, ?);

deleteSpam:
DELETE FROM SpamEntity WHERE phoneNumber = ?;

deleteAllSpams:
DELETE FROM SpamEntity;
